  if(Math.abs(mx-my)<1e-10){if(!onCorner(c+sx,r)||!onCorner(c,r+sy))return false;c+=sx;r+=sy;mx+=tx;my+=ty;}
  else if(mx<my){c+=sx;mx+=tx;}else{r+=sy;my+=ty;}
  if(!onCell(c,r))return false;
