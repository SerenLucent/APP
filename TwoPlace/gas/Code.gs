      if (product.type === 'food' && home.snacks+quantity > 100) throw new PetError('먹이는 최대 100개까지 보관할 수 있어요.');
      if (product.type !== 'food' && home.items.length >= 120) throw new PetError('가구는 최대 120개까지 보관할 수 있어요.');
