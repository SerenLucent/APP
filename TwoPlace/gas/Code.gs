class PetError extends Error {
  constructor(message,status=400) { super(message); this.status=status; }
}
function initialPetHome(now=Date.now()) {
  return {calendarRewards:{registration:{},reads:{},seen:[],backfilled:true},layoutVersion:1,version:0, hearts:120, snacks:4, lastClaim:now, pets:{mochi:{hunger:75,updatedAt:now},kuki:{hunger:75,updatedAt:now}}, items:[]};
}
function hunger(pet,now=Date.now()) { return petLevel(pet,'hunger',now); }
function claimable(home,now=Date.now()) { return hourlyHeartAmount(home,now); }
function petSnapshot(home,now=Date.now()) {
  const items=JSON.parse(JSON.stringify(home.items));syncTabletopItems(items);
  return {...home,items, serverNow:now, claimable:claimable(home,now), nextClaimAt:home.lastClaim+HOUR, pets:Object.fromEntries(Object.entries(home.pets).map(([id,pet]) => [id,{...pet,hunger:hunger(pet,now),hungerBase:pet.hunger,affinity:petLevel(pet,'affinity',now),energy:petLevel(pet,'energy',now),sampledAt:now}]))};
}
function changePetHome(current,action,now=Date.now(),idFactory=()=>crypto.randomUUID()) {
  if (!action || !Number.isSafeInteger(action.version) || action.version !== current.version) throw new PetError('상대가 먼저 펫 공간을 바꿨어요. 최신 상태에서 다시 시도해 주세요.',409);
  const home = JSON.parse(JSON.stringify(current));
  switch(action.type) {
    case 'claim': {
      const amount = claimable(home,now);
      if (!amount) throw new PetError('하트가 모이고 있어요. 한 시간이 지나면 받을 수 있어요.');
      home.hearts += amount;
      home.lastClaim = now;
      break;
    }
    case 'buy': {
      const product = CATALOG.find(item=>item.id === action.product);
      if (!product) throw new PetError('이 상품은 찾을 수 없어요.');
      if (home.hearts < product.price) throw new PetError('하트가 부족해요. 하트를 더 모아 주세요.');
      if (product.type === 'food' && home.snacks >= 100) throw new PetError('먹이는 최대 100개까지 보관할 수 있어요.');
      if (product.type === 'furniture' && home.items.length >= 120) throw new PetError('가구는 최대 120개까지 보관할 수 있어요.');
      home.hearts -= product.price;
      if (product.type === 'food') home.snacks++;
      else home.items.push({id:idFactory(),product:product.id,space:null,x:50,y:65});
      break;
    }
    case 'feed': {
      if (!['mochi','kuki'].includes(action.pet)) throw new PetError('어떤 친구에게 줄지 골라 주세요.');
      if (home.snacks < 1) throw new PetError('먹이가 없어요. 상점에서 구매해 주세요.');
      const level = hunger(home.pets[action.pet],now);
      if (level >= 100) throw new PetError('이미 배가 든든해요. 나중에 먹이를 주세요.');
      home.snacks--;
      const pet=home.pets[action.pet];home.pets[action.pet] = {...pet,affinityAt:pet.affinityAt??pet.updatedAt,energyAt:pet.energyAt??pet.updatedAt,hunger:Math.min(100,level+25),updatedAt:now};
      break;
    }
    case 'pat':
    case 'sleep':{
      if(!['mochi','kuki'].includes(action.pet))throw new PetError('돌볼 친구를 골라 주세요.');
      const kind=action.type==='pat'?'affinity':'energy',pet=home.pets[action.pet],reward=careRewardReady(home,action.pet,action.type,now);
      pet[kind]=100;pet[kind+'At']=now;if(reward){home.hearts++;home.careBonuses={...home.careBonuses,[action.pet]:{...home.careBonuses?.[action.pet],[action.type]:{day:careDay(now),count:careBonus(home,action.pet,action.type,now).count+1,lastAt:now}}};}break;
    }
    case 'placeOnTable': {
      const item=home.items.find(i=>i.id===action.item);
      if(!item||!isTabletop(item.product))throw new PetError('식탁에 올릴 음식을 골라 주세요.');
      if(![0,90,180,270].includes(action.rotation??0))throw new PetError('방향을 확인해 주세요.');
      if(!availableTableSlot(home.items,action.parentId,action.slot,item.id))throw new PetError('빈 식탁 상판 자리를 골라 주세요.');
      Object.assign(item,{parentId:action.parentId,slot:action.slot,rotation:action.rotation??0});syncTabletopItems(home.items);
      break;
    }
    case 'place': {
      const item = home.items.find(item=>item.id === action.item);
      if (!item) throw new PetError('보유한 가구만 배치할 수 있어요.');
      if(isTabletop(item.product))throw new PetError('음식은 식탁 위에만 배치할 수 있어요.');
      if (!SPACES.includes(action.space) || !Number.isFinite(action.x) || !Number.isFinite(action.y) || action.x<10 || action.x>90 || action.y<45 || action.y>88) throw new PetError('공간 안의 배치할 위치를 골라 주세요.');
      if(!usableInSpace(item.product,action.space))throw new PetError('이 가구는 해당 공간에 배치할 수 없어요.');
      const rotation=action.rotation ?? item.rotation ?? 0;
      if(![0,90,180,270].includes(rotation))throw new PetError('가구 방향을 확인해 주세요.');
      if(!placementAllowed(home.items,item,action.space,{x:action.x,y:action.y},rotation))throw new PetError('다른 가구와 겹치거나 바닥을 벗어나는 자리예요. 초록색 자리를 골라 주세요.');
      Object.assign(item,{space:action.space,x:action.x,y:action.y,rotation});syncTabletopItems(home.items);
      break;
    }
    case 'store': {
      const item = home.items.find(item=>item.id === action.item);
      if (!item) throw new PetError('가구를 찾을 수 없어요.');
      item.space = null;delete item.parentId;delete item.slot;syncTabletopItems(home.items);
      break;
    }
    default: throw new PetError('할 수 없는 동작이에요.');
  }
  syncTabletopItems(home.items);home.version++;
  return home;
}

// Keep ownership and currency; retire only placements invalid in the remodel.
function remodelPetHome(current){
 if(current.layoutVersion>=1)return current;
 const home=JSON.parse(JSON.stringify(current)),placed=[];let stored=0;
 for(const item of home.items){if(!item.space||item.parentId)continue;if(!usableInSpace(item.product,item.space)||!placementAllowed(placed,item,item.space,item,item.rotation||0)){item.space=null;delete item.parentId;delete item.slot;stored++;}else placed.push(item);}
 syncTabletopItems(home.items);home.layoutVersion=1;home.version++;home.remodel={version:1,stored};return home;
}

// Generated Code.gs also includes the same validation, pet economy and geometry as Node.
const GITHUB_OWNER='SerenLucent';
const GITHUB_REPO='APP';
const GITHUB_BRANCH='main';
const ROOM_PREFIX='TwoPlace/remote-data/couples/';
function setupTwoPlace(){
  const response=github_('', 'GET');
  if(response.permissions && response.permissions.push===false)fail_(403,'APP 저장소의 Contents 쓰기 권한이 필요해요.');
  return 'TwoPlace GitHub storage is ready.';
}
// Run from the Apps Script editor once. Store the token in a password manager.
// Running it again rotates the token and invalidates the previous one.
function issueAdminToken() {
  const token=Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');
  PropertiesService.getScriptProperties().setProperty('ADMIN_TOKEN_HASH',digest_(token));
  console.log('TwoPlace administrator token (save privately): '+token);
  return token;
}
function digest_(value) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,value,Utilities.Charset.UTF_8).map(x=>((x+256)%256).toString(16).padStart(2,'0')).join('');
}
function fail_(status,message){const e=new Error(message);e.status=status;throw e;}
function props_(){return PropertiesService.getScriptProperties();}
function github_(path,method,payload){
  const token=props_().getProperty('GITHUB_TOKEN');
  if(!token)fail_(503,'앱스크립트의 GITHUB_TOKEN 설정이 필요해요.');
  const response=UrlFetchApp.fetch('https://api.github.com/repos/'+GITHUB_OWNER+'/'+GITHUB_REPO+path,{
    method:method.toLowerCase(),muteHttpExceptions:true,
    headers:{Authorization:'Bearer '+token,Accept:'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28'},
    ...(payload?{contentType:'application/json',payload:JSON.stringify(payload)}:{})
  });
  const status=response.getResponseCode();
  if(status===409||status===422)fail_(409,'GitHub 파일이 먼저 바뀌었어요. 다시 불러와 주세요.');
  if(status===401||status===403)fail_(503,'GitHub 토큰과 APP 저장소 권한을 확인해 주세요.');
  if(status===404)fail_(404,'GitHub 저장 파일을 찾을 수 없어요.');
  if(status<200||status>=300)fail_(502,'GitHub 저장에 실패했어요. 잠시 후 다시 시도해 주세요.');
  return JSON.parse(response.getContentText());
}
function roomPath_(code){if(!/^\d{12}$/.test(code))fail_(400,'방 코드를 확인해 주세요.');return ROOM_PREFIX+code+'/room.json';}
function validPath_(path){
  if(typeof path!=='string'||!/^TwoPlace\/remote-data\/couples\/\d{12}\/(room\.json|places\.json|backups\/[a-zA-Z0-9_-]+\.json)$/.test(path))fail_(400,'TwoPlace 저장 경로만 사용할 수 있어요.');
  return path.split('/').map(encodeURIComponent).join('/');
}
function readRoom_(path){
  const data=github_('/contents/'+validPath_(path)+'?ref='+GITHUB_BRANCH,'GET');
  const text=Utilities.newBlob(Utilities.base64Decode(data.content.replace(/\s/g,''))).getDataAsString('UTF-8');
  return {path,sha:data.sha,room:JSON.parse(text)};
}
function writeJson_(path,room,sha,message){
  const result=github_('/contents/'+validPath_(path),'PUT',{
    message:message||'Update TwoPlace couple data',branch:GITHUB_BRANCH,
    content:Utilities.base64Encode(JSON.stringify(room,null,2),Utilities.Charset.UTF_8),...(sha?{sha}:{})
  });
  return result.content.sha;
}
function saveRoom_(entry){entry.room.updatedAt=Date.now();entry.sha=writeJson_(entry.path,entry.room,entry.sha);}
function snapshot_(room,role){return {code:room.code,role,recoveryEnabled:!!room.recovery,memberCount:room.members.length,revision:room.revision,state:room.state,petHome:petSnapshot(room.petHome),catalog:CATALOG};}
function recoveryHash_(code,password,salt){
  if(typeof password!=='string'||password.length<8||password.length>128)fail_(400,'복구 암호는 8~128자로 입력해 주세요.');
  let pepper=props_().getProperty('RECOVERY_PEPPER');
  if(!pepper){pepper=Utilities.getUuid()+Utilities.getUuid();props_().setProperty('RECOVERY_PEPPER',pepper);}
  return Utilities.computeHmacSha256Signature(JSON.stringify([code,salt,password]),pepper,Utilities.Charset.UTF_8).map(x=>((x+256)%256).toString(16).padStart(2,'0')).join('');
}
function recoveryAttempt_(code){
  const key='recovery-attempt:'+code,now=Date.now();
  let value=JSON.parse(props_().getProperty(key)||'null');
  if(!value||now-value.at>900000)value={at:now,count:0};
  if(value.count>=10)fail_(429,'복구 시도가 많아요. 15분 후 다시 시도해 주세요.');
  value.count++;props_().setProperty(key,JSON.stringify(value));
}
function member_(token){
  if(typeof token!=='string'||!/^[a-f0-9]{64}$/.test(token))fail_(401,'커플방에 다시 입장해 주세요.');
  const hashed=digest_(token),fileId=props_().getProperty('github-member:'+hashed);
  if(!fileId)fail_(401,'커플방에 다시 입장해 주세요.');
  const entry=readRoom_(fileId),member=entry.room.members.find(m=>m.hash===hashed);
  if(!member)fail_(401,'입장 정보를 확인해 주세요.');
  const remodeled=remodelPetHome(entry.room.petHome);if(remodeled!==entry.room.petHome){writeJson_(ROOM_PREFIX+entry.room.code+'/backups/remodel-v1_'+Date.now()+'_'+Utilities.getUuid()+'.json',entry.room,null,'Back up TwoPlace before home remodel');entry.room.petHome=remodeled;saveRoom_(entry);}
  const credited=backfillCalendarRewards(entry.room.petHome,entry.room.state);if(credited!==entry.room.petHome){writeJson_(ROOM_PREFIX+entry.room.code+'/backups/calendar-rewards_'+Date.now()+'_'+Utilities.getUuid()+'.json',entry.room,null,'Back up TwoPlace before calendar reward backfill');entry.room.petHome=credited;saveRoom_(entry);}
  return {...entry,role:member.role};
}
function admissionLimit_(kind){
  const cache=CacheService.getScriptCache(),key='admission:'+kind+':'+Math.floor(Date.now()/60000);
  const count=Number(cache.get(key)||0)+1;
  if(count> (kind==='create'?10:60))fail_(429,'잠시 후 다시 시도해 주세요.');
  cache.put(key,String(count),120);
}
function admin_(token){
  const expected=props_().getProperty('ADMIN_TOKEN_HASH');
  if(!expected||typeof token!=='string'||!/^[a-f0-9]{64}$/.test(token)||digest_(token)!==expected)fail_(403,'관리자 토큰을 확인해 주세요.');
}
function json_(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
function doGet(){return json_({service:'TwoPlace',storage:'github-json',repository:'SerenLucent/APP',prefix:ROOM_PREFIX,version:5});}
function doPost(e){
  const lock=LockService.getScriptLock();let locked=false;
  try {
    const raw=e&&e.postData&&e.postData.contents;
    if(!raw||raw.length>1000000)fail_(400,'요청 내용을 확인해 주세요.');
    let req;try{req=JSON.parse(raw);}catch(_){fail_(400,'요청 내용을 확인해 주세요.');}
    if(!req||typeof req!=='object')fail_(400,'요청 내용을 확인해 주세요.');
    locked=lock.tryLock(20000);if(!locked)fail_(503,'다른 저장을 처리 중이에요. 잠시 후 다시 시도해 주세요.');
    const data=route_(req);
    return json_({status:200,data});
  }catch(error){return json_({status:error.status||500,data:{error:error.status?error.message:'서버에서 처리하지 못했어요. 잠시 후 다시 시도해 주세요.',...(error.pmCode?{code:error.pmCode}:{})}});}
  finally{if(locked)lock.releaseLock();}
}
function route_(req){
  const body=req.body||{},path=req.path,method=req.method||'GET';
  if(path==='/health')return {ok:true};
  if(path==='/room/places/map-config'&&method==='GET'){member_(req.token);return pmNaverConfig_();}
  if(path==='/room/places/search'&&method==='POST'){const e=member_(req.token);return pmNaverSearch_(body.query,e.room.code+':'+e.role);}
  if(path==='/room/places'&&(method==='GET'||method==='PUT')){
    const e=member_(req.token),filePath=ROOM_PREFIX+e.room.code+'/places.json';
    let file;
    try{file=readRoom_(filePath);}catch(error){if(error.status!==404)throw error;file={path:filePath,sha:null,room:initialPlaces()};}
    if(method==='PUT')file.room=changePlaces(file.room,body,e.role,Date.now());
    if(method==='PUT'||!file.sha)file.sha=writeJson_(filePath,file.room,file.sha,'Save TwoPlace couple shared places');
    return {code:e.room.code,role:e.role,memberCount:e.room.members.length,...file.room,mapFeatures:2};
  }
  if(path==='/rooms/recover'&&method==='POST'){
    const code=typeof body.code==='string'?body.code.replace(/[\s-]/g,''):'';
    if(!/^\d{12}$/.test(code)||!['owner','partner'].includes(body.role)||!/^[a-f0-9]{64}$/.test(body.requestToken||''))fail_(400,'방 코드와 본인 자리를 확인해 주세요.');
    const hashed=digest_(body.requestToken),id=props_().getProperty('github-room:'+code);
    // A committed response can be retried after network loss with the same device token.
    if(props_().getProperty('github-member:'+hashed)){
      const e=member_(body.requestToken);
      if(e.room.code!==code||e.role!==body.role)fail_(409,'다른 연결에 사용한 요청이에요.');
      return {token:body.requestToken,...snapshot_(e.room,e.role)};
    }
    recoveryAttempt_(code);
    if(!id)fail_(403,'방 코드 또는 복구 암호를 확인해 주세요.');
    const e=readRoom_(id),r=e.room.recovery;
    if(!r||recoveryHash_(code,body.password,r.salt)!==r.hash)fail_(403,'방 코드 또는 복구 암호를 확인해 주세요.');
    const slot=e.room.members.find(m=>m.role===body.role);
    if(!slot)fail_(400,'아직 입장한 적 없는 자리예요. 커플방 입장하기를 이용해 주세요.');
    slot.hash=hashed;saveRoom_(e);
    props_().setProperty('github-member:'+hashed,id);
    props_().setProperty('recovery-attempt:'+code,JSON.stringify({at:Date.now(),count:0}));
    return {token:body.requestToken,...snapshot_(e.room,body.role)};
  }
  if(path==='/room/recovery'&&method==='PUT'){
    const e=member_(req.token),r=e.room.recovery;
    if(r){recoveryAttempt_(e.room.code);if(recoveryHash_(e.room.code,body.currentPassword,r.salt)!==r.hash)fail_(403,'현재 복구 암호를 확인해 주세요.');}
    const salt=Utilities.getUuid();
    e.room.recovery={salt,hash:recoveryHash_(e.room.code,body.password,salt)};saveRoom_(e);
    props_().setProperty('recovery-attempt:'+e.room.code,JSON.stringify({at:Date.now(),count:0}));
    return snapshot_(e.room,e.role);
  }
  if((path==='/rooms'||path==='/rooms/join')&&method==='POST'){
    const token=body.requestToken;
    if(typeof token!=='string'||!/^[a-f0-9]{64}$/.test(token))fail_(400,'입장 요청 정보를 확인해 주세요.');
    const hashed=digest_(token),existingId=props_().getProperty('github-member:'+hashed);
    const joining=path==='/rooms/join',code=typeof body.code==='string'?body.code.replace(/[\s-]/g,''):'';
    if(existingId){
      const entry=member_(token);
      if(entry.role!==(joining?'partner':'owner')||(joining&&entry.room.code!==code))fail_(409,'다른 방에 사용한 요청이에요.');
      return {token,...snapshot_(entry.room,entry.role)};
    }
    admissionLimit_(joining?'join':'create');
    if(joining){
      if(!/^\d{12}$/.test(code))fail_(400,'숫자 12자리 방 코드를 입력해 주세요.');
      const fileId=props_().getProperty('github-room:'+code);if(!fileId)fail_(404,'방 코드를 찾을 수 없어요.');
      const entry=readRoom_(fileId);
      if(entry.room.members.length>=2)fail_(409,'이미 두 사람이 입장한 커플방이에요.');
      entry.room.members.push({hash:hashed,role:'partner'});
      saveRoom_(entry);props_().setProperty('github-member:'+hashed,fileId);
      return {token,...snapshot_(entry.room,'partner')};
    }
    let newCode;
    do{newCode=String(parseInt(Utilities.getUuid().replace(/-/g,'').slice(0,12),16)%1000000000000).padStart(12,'0');}while(props_().getProperty('github-room:'+newCode));
    const now=Date.now(),room={schemaVersion:1,code:newCode,createdAt:now,updatedAt:now,revision:0,state:{startDate:null,events:[],notes:[]},petHome:initialPetHome(now),members:[{hash:hashed,role:'owner'}]};
    if(body.password){const salt=Utilities.getUuid();room.recovery={salt,hash:recoveryHash_(newCode,body.password,salt)};}
    const filePath=roomPath_(newCode);
    writeJson_(filePath,room,null,'Create TwoPlace couple room');
    props_().setProperties({['github-room:'+newCode]:filePath,['github-member:'+hashed]:filePath});
    return {token,...snapshot_(room,'owner')};
  }
  if(path==='/room'&&method==='GET'){const e=member_(req.token);return snapshot_(e.room,e.role);}
  if(path==='/room/state'&&method==='PUT'){
    const e=member_(req.token),state=memberState(e.room.state,body.state,e.role);
    if(!Number.isSafeInteger(body.revision)||body.revision!==e.room.revision)fail_(409,'상대가 먼저 수정했어요. 최신 내용을 확인해 주세요.');
    e.room.petHome=calendarRewards(e.room.petHome,e.room.state,state);e.room.state=state;e.room.revision++;saveRoom_(e);return snapshot_(e.room,e.role);
  }
  if(path==='/room/calendar/read'&&method==='POST'){const e=member_(req.token);e.room.petHome=calendarRewards(e.room.petHome,e.room.state,e.room.state,Date.now(),{readRole:e.role,eventId:body.eventId});saveRoom_(e);return snapshot_(e.room,e.role);}
  if(path==='/room/pets'&&method==='POST'){
    const e=member_(req.token);
    e.room.petHome=changePetHome(e.room.petHome,body,Date.now(),()=>Utilities.getUuid().replace(/-/g,''));
    saveRoom_(e);return snapshot_(e.room,e.role);
  }
  if(path==='/admin/rooms'&&method==='GET'){
    admin_(req.token);
    // Paginate the property index so listing never returns every room's private contents.
    const keys=Object.keys(props_().getProperties()).filter(k=>k.indexOf('github-room:')===0).sort();
    const offset=Math.max(0,Number(body.offset)||0),selected=keys.slice(offset,offset+50);
    return {rooms:selected.map(k=>({code:k.slice(12)})),nextOffset:offset+50<keys.length?offset+50:null};
  }
  if(path==='/admin/room'&&(method==='GET'||method==='PUT')){
    admin_(req.token);
    if(!/^\d{12}$/.test(body.code))fail_(400,'방 코드를 확인해 주세요.');
    const id=props_().getProperty('github-room:'+body.code);if(!id)fail_(404,'방이 없어요.');
    const e=readRoom_(id);
    if(method==='PUT'){
      if(body.revision!==e.room.revision||body.petVersion!==e.room.petHome.version)fail_(409,'방 데이터가 바뀌었어요. 다시 불러와 주세요.');
      const state=cleanState(body.state),pets=cleanAdminPets_(body.petHome);
      writeJson_(ROOM_PREFIX+e.room.code+'/backups/'+Date.now()+'_'+Utilities.getUuid()+'.json',e.room,null,'Back up TwoPlace couple before administrator edit');
      e.room.state=state;e.room.revision++;e.room.petHome={...pets,layoutVersion:e.room.petHome.layoutVersion,calendarRewards:e.room.petHome.calendarRewards,careRewards:e.room.petHome.careRewards,version:e.room.petHome.version+1};saveRoom_(e);
    }
    return snapshot_(e.room,'admin');
  }
  fail_(404,'요청한 기능이 없어요.');
}
function cleanAdminPets_(data){
  if(!data||!Number.isSafeInteger(data.hearts)||data.hearts<0||data.hearts>100000000||!Number.isSafeInteger(data.snacks)||data.snacks<0||data.snacks>100||!Array.isArray(data.items)||data.items.length>120)fail_(400,'하트·먹이·가구 값을 확인해 주세요.');
  const now=Date.now(),pets={};
  for(const id of ['mochi','kuki']){
    const pet=data.pets&&data.pets[id];
    if(!pet||!Number.isFinite(pet.hunger)||pet.hunger<0||pet.hunger>100)fail_(400,'펫 배부름 값을 확인해 주세요.');
    for(const key of ['affinity','energy'])if(pet[key]!==undefined&&(!Number.isFinite(pet[key])||pet[key]<0||pet[key]>100))fail_(400,'친밀도·체력 수치를 확인해 주세요.');pets[id]={hunger:pet.hunger,updatedAt:now,affinity:pet.affinity??100,affinityAt:now,energy:pet.energy??100,energyAt:now};
  }
  const ids=new Set(),items=[];
  for(const item of data.items){
    if(!item||typeof item.id!=='string'||!item.id||item.id.length>64||ids.has(item.id)||!(item.product==='fence'||CATALOG.some(p=>p.type==='furniture'&&p.id===item.product))||![null,...SPACES].includes(item.space)||![0,90,180,270].includes(item.rotation||0)||!Number.isFinite(item.x)||!Number.isFinite(item.y))fail_(400,'가구 데이터를 확인해 주세요.');
    const clean={id:item.id,product:item.product,space:item.space,x:item.x,y:item.y,rotation:item.rotation||0};
    if(isTabletop(clean.product)){if(item.parentId!==undefined){if(typeof item.parentId!=='string'||!Number.isInteger(item.slot))fail_(400,'식탁 연결 정보를 확인해 주세요.');clean.parentId=item.parentId;clean.slot=item.slot;}}else if(item.parentId!==undefined)fail_(400,'식탁 위에는 음식만 올릴 수 있어요.');
    if(clean.space&&!usableInSpace(clean.product,clean.space))fail_(400,'공간에 맞지 않는 가구예요.');
    if(clean.space&&!isTabletop(clean.product)&&!placementAllowed(items,clean,clean.space,clean,clean.rotation))fail_(400,'가구 위치가 겹치거나 바닥 밖에 있어요.');
    ids.add(clean.id);items.push(clean);
  }
  // Validate all pairs, independent of input ordering (rugs are allowed underneath).
  for(const item of items){if(isTabletop(item.product)){if(item.space){const parent=items.find(p=>p.id===item.parentId),point=tableSlot(parent,item.slot);if(!point||point.space!==item.space||Math.abs(point.x-item.x)>1e-6||Math.abs(point.y-item.y)>1e-6||!availableTableSlot(items,item.parentId,item.slot,item.id))fail_(400,'음식의 식탁 위치를 확인해 주세요.');}else if(item.parentId!==undefined)fail_(400,'보관한 음식의 연결을 확인해 주세요.');}else if(item.space&&!placementAllowed(items,item,item.space,item,item.rotation))fail_(400,'가구 위치를 확인해 주세요.');}
  return {version:0,hearts:data.hearts,snacks:data.snacks,lastClaim:now,pets,items};
}

/** Shared by PlaceMate and TwoPlace. Only the map browser ID is returned to clients. */
function pmNaverConfig_(){
  var props=PropertiesService.getScriptProperties();
  return {provider:'naver',mapClientId:props.getProperty('NAVER_MAP_CLIENT_ID')||'',searchReady:!!(props.getProperty('NAVER_SEARCH_CLIENT_ID')&&props.getProperty('NAVER_SEARCH_CLIENT_SECRET'))};
}
function pmNaverFail_(code){var e=new Error(code);e.pmCode=code;e.status=code==='NAVER_SEARCH_RATE_LIMIT'?429:503;throw e;}
function pmNaverText_(text){return String(text||'').replace(/<[^>]*>/g,'').replace(/&amp;/g,'&').replace(/&quot;/g,'"').replace(/&#39;|&apos;/g,"'").replace(/&lt;/g,'<').replace(/&gt;/g,'>').trim();}
function pmNaverSearch_(input,identity){
  if(typeof input!=='string'||input.trim().length<2||input.length>100)pmNaverFail_('INVALID_SEARCH_QUERY');
  var query=input.trim(),props=PropertiesService.getScriptProperties();
  var id=props.getProperty('NAVER_SEARCH_CLIENT_ID'),secret=props.getProperty('NAVER_SEARCH_CLIENT_SECRET');
  if(!id||!secret)pmNaverFail_('NAVER_SEARCH_NOT_CONFIGURED');
  var cache=CacheService.getScriptCache();
  var countKey='pm-nav-rate:'+identity+':'+Math.floor(Date.now()/60000);
  var count=Number(cache.get(countKey)||0);if(count>=15)pmNaverFail_('NAVER_SEARCH_RATE_LIMIT');cache.put(countKey,String(count+1),120);
  // Application-local daily cap; the provider console remains the authoritative limit.
  var today=Utilities.formatDate(new Date(),'Asia/Seoul','yyyy-MM-dd');
  var counter=JSON.parse(props.getProperty('PM_NAVER_SEARCH_USAGE')||'null');
  if(!counter||counter.date!==today)counter={date:today,count:0};
  var limit=Number(props.getProperty('NAVER_SEARCH_DAILY_LIMIT')||1000);
  if(!Number.isFinite(limit)||limit<1||counter.count>=limit)pmNaverFail_('NAVER_SEARCH_DAILY_LIMIT');
  counter.count++;props.setProperty('PM_NAVER_SEARCH_USAGE',JSON.stringify(counter));
  var response=UrlFetchApp.fetch('https://naverapihub.apigw.ntruss.com/search/v1/local?query='+encodeURIComponent(query)+'&display=5&start=1&sort=random&format=json',{
    method:'get',muteHttpExceptions:true,headers:{'X-NCP-APIGW-API-KEY-ID':id,'X-NCP-APIGW-API-KEY':secret}
  });
  var status=response.getResponseCode();
  if(status===401||status===403)pmNaverFail_('NAVER_SEARCH_AUTH_FAILED');
  if(status===429)pmNaverFail_('NAVER_SEARCH_RATE_LIMIT');
  if(status!==200)pmNaverFail_('NAVER_SEARCH_FAILED');
  var result=JSON.parse(response.getContentText());
  return {source:'NAVER',query:query,items:(result.items||[]).slice(0,5).map(function(item){
    var lng=Number(item.mapx),lat=Number(item.mapy);
    // NAVER returns WGS84 either as decimal degrees or scaled integers (1e7).
    if(Math.abs(lng)>180)lng/=10000000;if(Math.abs(lat)>90)lat/=10000000;
    if(!Number.isFinite(lat)||!Number.isFinite(lng)||Math.abs(lat)>85||Math.abs(lng)>180||(!lat&&!lng))return null;
    var name=pmNaverText_(item.title),address=pmNaverText_(item.roadAddress||item.address),raw=pmNaverText_(item.category);
    var category=/카페|커피|디저트|베이커리/.test(raw)?'카페':/음식|식당|요리|한식|양식|중식|일식|술집/.test(raw)?'맛집':'기타';
    var identityText=JSON.stringify([name,address,lat,lng]);
    var digest=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,identityText,Utilities.Charset.UTF_8).map(function(b){return ('0'+((b+256)%256).toString(16)).slice(-2);}).join('');
    return {canonicalId:'naver_'+digest,name:name,address:address,category:category,lat:lat,lng:lng};
  }).filter(function(item){return item&&item.name&&item.address;})};
}
