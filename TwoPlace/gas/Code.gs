function toWorld(point){return {u:(point.x-10)/80,v:(point.y-45)/43};}
function fromWorld(u,v){return {x:10+u*80,y:45+v*43};}
function project(point){const {u,v}=toWorld(point);return {x:FLOOR.cx+FLOOR.halfWidth*(u-v),y:FLOOR.top+FLOOR.halfHeight*(u+v)};}
function unproject(x,y){const dx=(x-FLOOR.cx)/FLOOR.halfWidth,dy=(y-FLOOR.top)/FLOOR.halfHeight;return fromWorld((dx+dy)/2,(dy-dx)/2);}
function insideFloor(point){const {u,v}=toWorld(point);return u>=0 && u<=1 && v>=0 && v<=1;}
function cellAt(point){const {u,v}=toWorld(point);return {c:Math.min(GRID_SIZE-1,Math.max(0,Math.floor(u*GRID_SIZE))),r:Math.min(GRID_SIZE-1,Math.max(0,Math.floor(v*GRID_SIZE)))};}
function cellCenter(c,r){return fromWorld((c+.5)/GRID_SIZE,(r+.5)/GRID_SIZE);}
function snap(point){const {c,r}=cellAt(point);return cellCenter(c,r);}
function footprint(item){const size=footprints[item.product] || [1,1];return item.rotation%180===90 ? [size[1],size[0]] : size;}
// Fixed living-room sofa (2 × 4) and kitchen (4 × 1) share the floor grid.
function builtInOverlap(space,u,v,w,h){
  if(space!=='home'&&space!=='upperFloor')return false;
  const e=1e-6;
  return u+w/(GRID_SIZE*2)>17/GRID_SIZE+e && u-w/(GRID_SIZE*2)<19/GRID_SIZE-e && v-h/(GRID_SIZE*2)<5/GRID_SIZE-e;
}
function placementAllowed(items,item,space,point,rotation=item.rotation || 0){
  if(isWallProduct(item.product)||isFloorProduct(item.product))return false;
  if(isTabletop(item.product))return false;
  if(!insideFloor(point)) return false;
  const {u,v}=toWorld(point),[w,h]=footprint({...item,rotation});
  const margin=1e-6;
  if(u-w/(GRID_SIZE*2) < -margin || u+w/(GRID_SIZE*2)>1+margin || v-h/(GRID_SIZE*2) < -margin || v+h/(GRID_SIZE*2)>1+margin) return false;
  if(builtInOverlap(space,u,v,w,h))return false;
  if(item.product==='rug')return true;
  return !items.some(other=>{
    if(other.id===item.id || other.space!==space || other.product==='rug'||isTabletop(other.product)||isWallProduct(other.product)||isFloorProduct(other.product))return false;
    const pos=toWorld(other),[ow,oh]=footprint(other);
    return Math.abs(pos.u-u)<(w+ow)/(GRID_SIZE*2)-.008 && Math.abs(pos.v-v)<(h+oh)/(GRID_SIZE*2)-.008;
  });
}
function walkable(items,space,c,r){
